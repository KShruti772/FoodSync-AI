# =============================================================================
# FoodSync AI — Environment Variable Template
# =============================================================================
# Copy this file to .env before starting local development.
# NEVER commit the actual .env file or real secrets to version control.
# =============================================================================

# FastAPI Backend Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Primary Relational Database (PostgreSQL 15+)
DATABASE_URL=postgresql://user:password@localhost:5432/foodsync_db

# Authentication / Security (Argon2id & JWT)
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client & CORS Configuration
CLIENT_URL=http://localhost:3000

# Deterministic Heuristic Matching Weights (Sum = 1.00)
MATCH_WEIGHT_DISTANCE=0.35
MATCH_WEIGHT_URGENCY=0.30
MATCH_WEIGHT_CAPACITY=0.20
MATCH_WEIGHT_REQUIREMENT=0.15
SYSTEM_MAX_RADIUS_KM=15.0
